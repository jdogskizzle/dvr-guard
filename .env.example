# Copy this file to .env and fill in your own values.

# Jellyfin's address as seen from this container, e.g. http://jellyfin:8096
# when both are on the same Docker network.
JELLYFIN_URL=

# An API key from Jellyfin: Dashboard > API Keys > +.
JELLYFIN_API_KEY=

# The Docker network Jellyfin is on.
DOCKER_NETWORK=

# The tuner's M3U playlist (HDHomeRun: http://<ip>/lineup.m3u). Used to record a show
# straight from the tuner when it has disappeared from the guide. Leave empty to skip that.
SOURCE_M3U=

# Host folder for those recordings (usually Jellyfin's recording folder).
RECORD_DIR=

# User and group the container runs as. They need write access to RECORD_DIR.
# Run `id -u` and `id -g` to find yours.
PUID=
PGID=

# Your time zone, for recording file names, e.g. America/Los_Angeles.
TZ=

# Minutes added to the end of a tuner recording, since live sports often run long.
FALLBACK_EXTRA_MINUTES=30
