# Copy this file to .env and fill in your own values.

# Jellyfin's address as seen from this container, e.g. http://jellyfin:8096
# when both are on the same Docker network. Include the base URL if Jellyfin has one
# (Dashboard > Networking), e.g. http://jellyfin:8096/jellyfin.
JELLYFIN_URL=

# An API key from Jellyfin: Dashboard > API Keys > +.
JELLYFIN_API_KEY=

# The Docker network Jellyfin is on.
DOCKER_NETWORK=

# The tuner's M3U playlist (HDHomeRun: http://<ip>/lineup.m3u).
SOURCE_M3U=

# This service's address as Jellyfin (and anything else using its playlist) sees it,
# e.g. http://dvr-guard:8000 on the same Docker network. Streams in the playlist point here.
PUBLIC_URL=

# Host folder Jellyfin records into (its Live TV "Recording path"), mounted at /recordings.
RECORD_DIR=

# User and group the container runs as. They need write access to RECORD_DIR.
# Run `id -u` and `id -g` to find yours.
PUID=
PGID=
# Optional: another group that can write to RECORD_DIR (e.g. a shared "media" group).
# `getent group media` shows its id.
EXTRA_GID=

# Your time zone, for log times, e.g. America/Los_Angeles.
TZ=

# Minutes added to the end of every recording, on top of Jellyfin's padding.
EXTRA_MINUTES=0

# Sign-in for the status page. Make a hash with:
#   docker compose run --rm -it --no-deps dvr-guard python -m formlogin hash
# and quote it with single quotes here.
DVR_USERNAME=
DVR_PASSWORD_HASH=
